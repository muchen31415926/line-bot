  },
  "main": "src/index.js",
  "dependencies": {
    "@google/genai": "^1.46.0",
    "@line/bot-sdk": "^10.6.0",
    "@supabase/supabase-js": "^2.103.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "file-type": "^22.0.0",
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.0.0"
  },
  "devDependencies": {
    "firebase-functions-test": "^3.4.1"
  },
  "private": true
}
